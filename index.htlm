
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FenstyGPT</title>

<style>
*{box-sizing:border-box}

body{
 margin:0;
 background:#10131b;
 color:white;
 font-family:Arial,sans-serif;
 transition:background .4s,color .3s;
 overflow-x:hidden;
}

header{
 height:65px;
 padding:0 16px;
 background:#191e2a;
 display:flex;
 justify-content:space-between;
 align-items:center;
 border-bottom:1px solid #303747;
 position:relative;
 z-index:3;
}

.logo{font-size:23px;font-weight:bold}
.logo span{color:#8b9cff}

button{
 border:0;
 border-radius:12px;
 padding:12px 16px;
 background:#7185ff;
 color:white;
 font-size:16px;
 cursor:pointer;
}

#chat{
 height:calc(100dvh - 145px);
 overflow-y:auto;
 padding:16px;
 max-width:800px;
 margin:auto;
 position:relative;
 z-index:1;
}

.msg{
 padding:13px 16px;
 margin:12px 0;
 border-radius:16px;
 max-width:88%;
 line-height:1.5;
 white-space:pre-wrap;
 overflow-wrap:anywhere;
}

.user{
 background:#465bd8;
 margin-left:auto;
}

.bot{background:#252c3b}

form{
 position:fixed;
 bottom:0;
 left:0;
 width:100%;
 display:flex;
 gap:8px;
 padding:12px;
 background:#10131b;
 z-index:3;
}

form input{
 flex:1;
 min-width:0;
 padding:15px;
 border:1px solid #414a60;
 border-radius:14px;
 background:#202635;
 color:white;
 font-size:16px;
}

#settings{
 display:none;
 position:fixed;
 inset:0;
 background:#000b;
 z-index:10;
 align-items:center;
 justify-content:center;
 padding:15px;
}

.panel{
 background:#202635;
 padding:22px;
 border-radius:20px;
 width:100%;
 max-width:400px;
 max-height:90vh;
 overflow-y:auto;
 box-shadow:0 15px 50px #0008;
}

.panel h2{margin-top:0}

.panel label{
 display:block;
 margin-top:17px;
 margin-bottom:8px;
}

.panel input,.panel select{
 width:100%;
 padding:13px;
 border:1px solid #566078;
 border-radius:10px;
 background:#10131b;
 color:white;
 font-size:15px;
}

.panel input[type=color]{height:48px}

.actions{
 display:flex;
 gap:8px;
 margin-top:20px;
}

.actions button{flex:1}
.close{background:#454e61}
.delete{background:#a83240;width:100%;margin-top:12px}

.light{background:#f1f3f8;color:#161b28}
.light header{background:white;border-color:#ddd}
.light .bot{background:#fff;color:#161b28}
.light form{background:#f1f3f8}
.light form input{background:white;color:#161b28}

.ocean{background:#071e32}
.ocean header{background:#0b304c}
.ocean .bot{background:#12405d}
.ocean form{background:#071e32}

.custom{background:var(--custom-bg,#10131b)}

.christmas{
 background:
 radial-gradient(ellipse at 50% 75%,#183b43 0%,transparent 65%),
 linear-gradient(#071426,#102d35 65%,#071b19);
}

.christmas header{
 background:#10251fdd;
 border-color:#42634c;
}

.christmas .logo span{color:#e6c77a}
.christmas .bot{
 background:#183c2bdd;
 border:1px solid #496b4d;
}
.christmas .user{background:#a52b35}
.christmas form{background:#0b201d}

.snow-layer{
 display:none;
 position:fixed;
 inset:65px 0 0;
 pointer-events:none;
 z-index:0;
 overflow:hidden;
}

.christmas .snow-layer{display:block}

.snow-layer span{
 position:absolute;
 color:white;
 opacity:.8;
 font-size:16px;
 animation:sideways 8s ease-in-out infinite alternate;
}

.snow-layer span:nth-child(1){top:15%;left:10%;animation-duration:8s}
.snow-layer span:nth-child(2){top:35%;left:75%;animation-duration:11s}
.snow-layer span:nth-child(3){top:55%;left:35%;animation-duration:9s}
.snow-layer span:nth-child(4){top:25%;left:55%;animation-duration:12s}
.snow-layer span:nth-child(5){top:70%;left:85%;animation-duration:10s}
.snow-layer span:nth-child(6){top:45%;left:15%;animation-duration:13s}
.snow-layer span:nth-child(7){top:80%;left:60%;animation-duration:8s}
.snow-layer span:nth-child(8){top:12%;left:90%;animation-duration:11s}
.snow-layer span:nth-child(9){top:65%;left:5%;animation-duration:14s}
.snow-layer span:nth-child(10){top:90%;left:45%;animation-duration:9s}

@keyframes sideways{
 0%{transform:translateX(-40px) rotate(0deg)}
 100%{transform:translateX(40px) rotate(180deg)}
}

.winter-forest{
 display:none;
 position:fixed;
 bottom:0;
 left:0;
 width:100%;
 text-align:center;
 font-size:clamp(23px,6vw,42px);
 letter-spacing:2px;
 white-space:nowrap;
 opacity:.8;
 pointer-events:none;
 z-index:0;
}

.christmas .winter-forest{display:block}

@media(max-width:450px){
 .logo{font-size:20px}
 #chat{padding:10px}
 .msg{max-width:92%}
}
</style>
</head>

<body>

<div class="snow-layer">
 <span>❄</span><span>❅</span><span>❄</span>
 <span>❆</span><span>❄</span><span>❅</span>
 <span>❄</span><span>❆</span><span>❄</span>
 <span>❅</span>
</div>

<div class="winter-forest">
 🌲 🌲 🌲 🌲 🌲 🌲 🌲 🌲
</div>

<header>
 <div class="logo">🤖 <span>Fensty</span>GPT</div>
 <button onclick="openSettings()">⚙️</button>
</header>

<div id="chat">
 <div class="msg bot">
 Hey! 👋 Ich bin FenstyGPT.

 Was möchtest du heute wissen?
 </div>
</div>

<form id="form">
 <input id="message"
 placeholder="Schreib eine Nachricht..."
 autocomplete="off">
 <button type="submit">➤</button>
</form>

<div id="settings">
 <div class="panel">

  <h2>⚙️ Einstellungen</h2>

  <label>🎨 Hintergrund</label>
  <select id="theme">
   <option value="dark">🌙 Dunkel</option>
   <option value="light">☀️ Hell</option>
   <option value="ocean">🌊 Ozean</option>
   <option value="christmas">🎄 Weihnachten</option>
   <option value="custom">🎨 Eigene Farbe</option>
  </select>

  <label>Eigene Hintergrundfarbe</label>
  <input type="color" id="customColor" value="#10131b">

  <label>🔠 Schriftgröße</label>
  <select id="fontSize">
   <option value="14">Klein</option>
   <option value="16">Normal</option>
   <option value="19">Groß</option>
   <option value="22">Sehr groß</option>
  </select>

  <label>🤖 Name deiner KI</label>
  <input id="botName" value="FenstyGPT" maxlength="30">

  <div class="actions">
   <button onclick="saveSettings()">💾 Speichern</button>
   <button class="close" onclick="closeSettings()">Schließen</button>
  </div>

  <button class="delete" onclick="clearChat()">
   🗑️ Chat löschen
  </button>

 </div>
</div>

<script>
const chat=document.getElementById("chat");
const form=document.getElementById("form");
const input=document.getElementById("message");

let settings={
 theme:"dark",
 color:"#10131b",
 font:"16",
 name:"FenstyGPT"
};

function loadSettings(){
 try{
  const saved=JSON.parse(localStorage.getItem("fenstySettings"));
  if(saved) settings={...settings,...saved};
 }catch(e){}
 applySettings();
}

function applySettings(){
 document.body.className=
 settings.theme==="custom"?"custom":settings.theme;

 document.body.style.setProperty(
  "--custom-bg",settings.color
 );

 document.getElementById("theme").value=settings.theme;
 document.getElementById("customColor").value=settings.color;
 document.getElementById("fontSize").value=settings.font;
 document.getElementById("botName").value=settings.name;

 document.querySelector(".logo span").textContent=
  settings.name.replace(/GPT$/,"");

 document.querySelectorAll(".msg").forEach(m=>{
  m.style.fontSize=settings.font+"px";
 });
}

function openSettings(){
 document.getElementById("settings").style.display="flex";
}

function closeSettings(){
 document.getElementById("settings").style.display="none";
}

function saveSettings(){
 settings.theme=document.getElementById("theme").value;
 settings.color=document.getElementById("customColor").value;
 settings.font=document.getElementById("fontSize").value;
 settings.name=document.getElementById("botName").value.trim()||"FenstyGPT";

 localStorage.setItem("fenstySettings",JSON.stringify(settings));
 applySettings();
 closeSettings();
}

function addMessage(text,type){
 const div=document.createElement("div");
 div.className="msg "+type;
 div.textContent=text;
 div.style.fontSize=settings.font+"px";
 chat.appendChild(div);
 chat.scrollTop=chat.scrollHeight;
}

function clearChat(){
 chat.innerHTML="";
 addMessage("Hey! 👋 Ich bin "+settings.name+". Was möchtest du wissen?","bot");
 closeSettings();
}

form.addEventListener("submit",async e=>{
 e.preventDefault();

 const text=input.value.trim();
 if(!text)return;

 addMessage(text,"user");
 input.value="";

 addMessage("Die echte KI-Verbindung wird als Nächstes eingerichtet. 🤖","bot");
});

loadSettings();
</script>

</body>
</html>
